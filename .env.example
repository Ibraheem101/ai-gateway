# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-jwt-key-change-in-production-min-32-chars

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_gateway_db

# Redis & Arq Queue
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration
# Set to 'gemini' to use Google AI Studio, or 'mock' for offline testing
LLM_PROVIDER=mock
GEMINI_API_KEY=your_google_ai_studio_free_key_here
